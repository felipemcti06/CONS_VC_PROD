#region Prolog


# ===============================================================================================================
# Chamador: executa em sequência a atualização das dimensões de contas (ALL.D.Accounts e derivados DFS.D.*)
# Ordem: 05 -> 10 -> 20 -> 30 -> 40 -> 50
# ===============================================================================================================

ExecuteProcess( 'ALL.D.0100.05.Atualiza_ALL.D.Accounts' );

ExecuteProcess( 'ALL.D.0100.10.Atualiza_DFS.D.Accounts_Fin_Results' );

ExecuteProcess( 'ALL.D.0100.20.Atualiza_DFS.D.Accounts_PnL' );

ExecuteProcess( 'ALL.D.0100.30.Atualiza_DFS.D.Accounts_Debt' );

ExecuteProcess( 'ALL.D.0100.40.Atualiza_DFS.D.Accounts_WC' );

ExecuteProcess( 'ALL.D.0100.50.Atualiza_DFS.D.Accounts_ICF' );


#endregion
