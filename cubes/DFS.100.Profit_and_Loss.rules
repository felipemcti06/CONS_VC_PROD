# --------------------------------------------------------------------------------------------
  ['DFS.D.Accounts_PnL':'DFS.D.Accounts_PnL':'DRE.099.014' , 'DFS.M.100.Profit_and_Loss':'DFS.M.100.Profit_and_Loss':'Value'] =
    ['DFS.D.Accounts_PnL':'DFS.D.Accounts_PnL':'DRE.099.010']
    \
    ['DFS.D.Accounts_PnL':'DFS.D.Accounts_PnL':'DRE.099.009'];
# --------------------------------------------------------------------------------------------
# Name:  Income Tax Adjustments
# Desc:   Income Tax Adjustments
# Date 01/2026
# Author: Miranda / Helder
# --------------------------------------------------------------------------------------------
  ['DFS.D.Accounts_PnL':'DFS.D.Accounts_PnL':'DRE.099.010' , 'DFS.M.100.Profit_and_Loss':'DFS.M.100.Profit_and_Loss':'Adjustments'] = N: 
(
     ( ['DFS.D.Accounts_PnL':'DFS.D.Accounts_PnL':'DRE.099.004']
    +
    ['DFS.D.Accounts_PnL':'DFS.D.Accounts_PnL':'NOR.010.001']
       +
   ['DFS.D.Accounts_PnL':'DFS.D.Accounts_PnL':'DEP.010.001']
    +
   ['DFS.D.Accounts_PnL':'DFS.D.Accounts_PnL':'DRE.099.007'] )
    *
   DB( 'ALL.015.Region_Assumptions', 
       !ALL.D.Year, 
       !ALL.D.Month,
       !ALL.D.Version, 
       !ALL.D.Region,
       '% Income Tax', 'Value' )
  )
    ;


