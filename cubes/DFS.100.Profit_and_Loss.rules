  ['DFS.M.100.Profit_and_Loss':'DFS.M.100.Profit_and_Loss':'Value','DFS.D.Accounts_PnL':'DFS.D.Accounts_PnL':'REV.099.002'] = N:
  DB('REV.100.Revenue_Consolidated',
     !ALL.D.Year,
     !ALL.D.Month,
     !ALL.D.Version,
     !ALL.D.Currency,
     !ALL.D.Region,
     !ALL.D.Products,
    'ALL.D.Market':'Total Market',
     'REV.M.100.Revenue_Consolidated':'Gross Revenue [$MM]'
    );

