  , DB('DFS.100.Profit_and_Loss', 
                !ALL.D.Year, 
                !ALL.D.Month, 
                !ALL.D.Version, 
                !ALL.D.Currency, 
                'ALL.D.Region':'Hard Currency', 
                !ALL.D.Products, 
                'DRE.099.004', 
                'DFS.M.100.Profit_and_Loss':'Total Value' )
  \
   DB('DFS.100.Profit_and_Loss', 
                !ALL.D.Year, 
                !ALL.D.Month, 
                !ALL.D.Version, 
                !ALL.D.Currency, 
                'ALL.D.Region':'Global', 
                !ALL.D.Products, 
                'DRE.099.004', 
                'DFS.M.100.Profit_and_Loss':'Total Value' )
  ,0 ); 



