# --------------------------------------------------------------------------------------------
#
#                      			INICIO DO BLOCO CALCULOS 
#
# --------------------------------------------------------------------------------------------
# --------------------------------------------------------------------------------------------
# Name Define versões calculadas
# Desc A partir dessa regra só calcula para versões dinâmicas
# Date 01/2026
# Author: Miranda / Helder
# --------------------------------------------------------------------------------------------
[]=IF(ELISANC( 'ALL.D.Version', 'Dynamic Versions', !ALL.D.Version ) <> 0 
  % !ALL.D.Version@='RE' 
  ,CONTINUE
  ,STET
  ); 

# --------------------------------------------------------------------------------------------
# Name: Definir versão RE para ACTUAL
# Desc: Para versões dinâmicas com flag ACTUAL, direciona cálculo para RE.
# Date 04/2026
# Author: Miranda 
# --------------------------------------------------------------------------------------------
[]=IF(
  ELISANC( 'ALL.D.Version', 'Dynamic Versions', !ALL.D.Version ) <> 0 
  &
  DB( 'ALL.001.Actual_Control', !ALL.D.Year, !ALL.D.Month, !ALL.D.Version, 'Flag' )@='ACTUAL',
        ['ALL.D.Version':'ALL.D.Version':'RE'],
        CONTINUE) ;


# --------------------------------------------------------------------------------------------
# Name: Production volume (kt)
# Desc: Calculo de Production volume (kt).
# Date 02/2026
# Author: Miranda / Helder
# --------------------------------------------------------------------------------------------
 ['DFS.D.KPI':'DFS.D.KPI':'KPI.010.001','DFS.M.200.KPIs':'DFS.M.200.KPIs':'Value'] =N:
  DB('STG.100.DataBase_Uploads', 
           !ALL.D.Year, 
           !ALL.D.Month, 
           !ALL.D.Version, 
           !ALL.D.Currency, 
           !ALL.D.Region, 
           !ALL.D.Products, 
            'KPI.010.001',
            'N/A',
            'Value');
# --------------------------------------------------------------------------------------------
# Name: Thermal Sub. (%)
# Desc: Calculo de Thermal Sub. (%).
# Date 02/2026
# Author: Miranda / Helder
# --------------------------------------------------------------------------------------------
['DFS.D.KPI':{'KPI.010.002','KPI.010.003','KPI.010.004','KPI.010.005','KPI.010.006','KPI.010.007','KPI.010.008','KPI.010.009','KPI.010.010','KPI.010.011','KPI.010.012','KPI.010.013',
'KPI.010.014','KPI.010.015','KPI.010.016','KPI.010.017','KPI.010.018','KPI.010.019','KPI.010.020','KPI.010.021','KPI.010.022','KPI.010.023'},'ALL.D.Month':'ALL.D.Month':{'Year','1st Quarter','2nd Quarter','3rd Quarter','4th Quarter','1st Semester','2nd Semester',
'YTD 01','YTD 02','YTD 03','YTD 04','YTD 05','YTD 06','YTD 07','YTD 08','YTD 09','YTD 10','YTD 11','YTD 12'},'DFS.M.200.KPIs':'DFS.M.200.KPIs':'Value']
=C:
  ['DFS.M.200.KPIs':'DFS.M.200.KPIs':'Aux'] 
  \ 
  ['DFS.D.KPI':'DFS.D.KPI':'KPI.010.001'];
