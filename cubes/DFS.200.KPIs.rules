# --------------------------------------------------------------------------------------------
# Name Petcoke Price (LMU/t)
# Desc: Calculo de Petcoke Price (LMU/t).
# Date 02/2026
# Author: Miranda / Helder
# --------------------------------------------------------------------------------------------
 ['DFS.D.KPI':'DFS.D.KPI':'KPI.010.024','ALL.D.Month':'Total Months','DFS.M.200.KPIs':'DFS.M.200.KPIs':'Value']= C:
  ConsolidatedAvg( 1, 'DFS.200.KPIs'
                                      ,!ALL.D.Year
                                     , 'ALL.D.Month':'YTD 12'
                                    , !ALL.D.Version
                                    , !ALL.D.Currency
                                     , !ALL.D.Region
                                     , !ALL.D.Products
                                     , 'KPI.010.024','Value' );

# --------------------------------------------------------------------------------------------
# Name Petcoke Price (LMU/t)
