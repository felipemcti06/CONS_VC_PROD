  +
  DB('DFS.200.KPIs', !ALL.D.Year, '05', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products, 'DFS.D.KPI':'Assets' )
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '06', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products, 'DFS.D.KPI':'Assets' )
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '07', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products, 'DFS.D.KPI':'Assets' )
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '08', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products, 'DFS.D.KPI':'Assets' )
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '09', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products, 'DFS.D.KPI':'Assets' )
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '10', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products, 'DFS.D.KPI':'Assets' )
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '11', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products, 'DFS.D.KPI':'Assets' )
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '12', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products, 'DFS.D.KPI':'Assets' ))
  /12
  +
    (DB('DFS.200.KPIs', !ALL.D.Year, '01', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products, 'DFS.D.KPI':'KPI.010.045' )
  +
DB('DFS.200.KPIs', !ALL.D.Year, '02', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products,  'DFS.D.KPI':'KPI.010.045' )
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '03', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products, 'DFS.D.KPI':'KPI.010.045' )
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '04', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products,  'DFS.D.KPI':'KPI.010.045')
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '05', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products,  'DFS.D.KPI':'KPI.010.045' )
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '06', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products,  'DFS.D.KPI':'KPI.010.045' )
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '07', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products,  'DFS.D.KPI':'KPI.010.045')
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '08', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products,  'DFS.D.KPI':'KPI.010.045' )
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '09', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products,  'DFS.D.KPI':'KPI.010.045')
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '10', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products,  'DFS.D.KPI':'KPI.010.045' )
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '11', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products,  'DFS.D.KPI':'KPI.010.045')
  +
  DB('DFS.200.KPIs', !ALL.D.Year, '12', !ALL.D.Version, !ALL.D.Currency, !ALL.D.Region, !ALL.D.Products,  'DFS.D.KPI':'KPI.010.045' ))
  /12;

