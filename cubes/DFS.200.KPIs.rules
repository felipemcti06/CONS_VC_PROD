 ['DFS.D.KPI':'DFS.D.KPI':'KPI.010.024','ALL.D.Month':'ALL.D.Month':{'1st Quarter','2nd Quarter','3rd Quarter','4th Quarter','1st Semester','2nd Semester',
'YTD 01','YTD 02','YTD 03','YTD 04','YTD 05','YTD 06','YTD 07','YTD 08','YTD 09','YTD 10','YTD 11','YTD 12'},'DFS.M.200.KPIs':'DFS.M.200.KPIs':'Value']= C:
     ConsolidatedAvg( 1, 'DFS.200.KPIs'
                                      ,!ALL.D.Year
                                     , !ALL.D.Month
                                    , !ALL.D.Version
                                    , !ALL.D.Currency
                                     , !ALL.D.Region
                                     , !ALL.D.Products
                                     , 'KPI.010.024','Value' );
