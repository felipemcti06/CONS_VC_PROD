  # +
  #     DB('DFS.200.KPIs', 
  #               !ALL.D.Year, 
  #                DB('SYS.200.Time_Travel', !ALL.D.Year, !ALL.D.Month, '-1','Mes'), 
  #               !ALL.D.Version, 
  #               !ALL.D.Currency, 
  #               !ALL.D.Region, 
  #               !ALL.D.Products, 
  #               !DFS.D.KPI, !DFS.M.200.KPIs );
   DB('DFS.100.Profit_and_Loss', 
              DB('SYS.200.Time_Travel',!ALL.D.Year,!ALL.D.Month,'-12','Ano'), 
              'ALL.D.Month':'YTD 12', 
              !ALL.D.Version, 
              !ALL.D.Currency, 
              !ALL.D.Region, 
              !ALL.D.Products, 
              'DEP.010.001' , 
              'DFS.M.100.Profit_and_Loss':'Total Value' )
   -
      DB('DFS.100.Profit_and_Loss', 
              DB('SYS.200.Time_Travel',!ALL.D.Year,!ALL.D.Month,'-12','Ano'), 
              'YTD ' | !ALL.D.Month, 
              !ALL.D.Version, 
              !ALL.D.Currency, 
              !ALL.D.Region, 
              !ALL.D.Products, 
              'DEP.010.001' , 
              'DFS.M.100.Profit_and_Loss':'Total Value' )
   +
         DB('DFS.100.Profit_and_Loss', 
              !ALL.D.Year, 
              'YTD ' | !ALL.D.Month, 
              !ALL.D.Version, 
              !ALL.D.Currency, 
              !ALL.D.Region, 
              !ALL.D.Products, 
              'DEP.010.001' , 
              'DFS.M.100.Profit_and_Loss':'Total Value' );
# --------------------------------------------------------------------------------------------
# Name: Income Tax Theoretical
# Desc: Calculo de Income Tax Theoretical.
# Date 02/2026
# Author: Miranda / Helder
# --------------------------------------------------------------------------------------------
['DFS.D.KPI':'DFS.D.KPI':'KPI.010.044','DFS.M.200.KPIs':'DFS.M.200.KPIs':'Value']=N:
    (DB('DFS.200.KPIs', 
            !ALL.D.Year, 
            !ALL.D.Month, 
            !ALL.D.Version, 
            !ALL.D.Currency, 
            !ALL.D.Region, 
            !ALL.D.Products, 'KPI.010.043','Value')
     +
    DB('DFS.100.Profit_and_Loss', 
             !ALL.D.Year, 
             !ALL.D.Month, 
             !ALL.D.Version, 
             !ALL.D.Currency, 
             !ALL.D.Region, 
             !ALL.D.Products, 
               'OOR.010.001', 
               'DFS.M.100.Profit_and_Loss':'Total Value' )
     -
     DB('DFS.200.KPIs', 
            !ALL.D.Year, 
            !ALL.D.Month, 
            !ALL.D.Version, 
            !ALL.D.Currency, 
            !ALL.D.Region, 
            !ALL.D.Products, 'KPI.010.043','Value')
      +
    DB('DFS.100.Profit_and_Loss', 
             !ALL.D.Year, 
             !ALL.D.Month, 
             !ALL.D.Version, 
             !ALL.D.Currency, 
             !ALL.D.Region, 
             !ALL.D.Products, 
               'DFS.D.Accounts_PnL':'DRE.099.007', 
              'Value')
      +
      
     DB('STG.100.DataBase_Uploads', 
     !ALL.D.Year, 
     !ALL.D.Month,
     !ALL.D.Version,
     !ALL.D.Currency,
     !ALL.D.Region,
     !ALL.D.Products,
     'NOP.020.001',
      'N/A', 
     'Value'))
    
    *
   DB( 'ALL.015.Region_Assumptions', 
       !ALL.D.Year, 
       !ALL.D.Month,
       !ALL.D.Version, 
       !ALL.D.Region,
       '% Income Tax Theoretical' ,'Value');
