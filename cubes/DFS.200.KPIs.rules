# --------------------------------------------------------------------------------------------
['DFS.D.KPI':'DFS.D.KPI':'KPI.010.026','ALL.D.Month':'ALL.D.Month':{'02','03','04','05','06','07','08','09','10','11','12'},'DFS.M.200.KPIs':'DFS.M.200.KPIs':'Value']= N:
  #   DB('DFS.100.Profit_and_Loss', 
  #              !ALL.D.Year, 
  #              !ALL.D.Month, 
  #              !ALL.D.Version, 
  #              !ALL.D.Currency, 
  #              !ALL.D.Region, 
  #              !ALL.D.Products, 
