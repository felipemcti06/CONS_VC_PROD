  ['DFS.D.Accounts_ICF':'DFS.D.Accounts_ICF':'FCF.020.001','DFS.M.140.Indirect_Cash_Flow':'DFS.M.140.Indirect_Cash_Flow':'Value'] = N:
  DB('STG.100.DataBase_Uploads', 
     !ALL.D.Year, 
     !ALL.D.Month,
     !ALL.D.Version,
     !ALL.D.Currency,
     !ALL.D.Region,
     'ALL.D.Products':'Total Products',
     'Income Tax Payments - Cash',
      'ALL.D.Account_Line':'Total Accounts Line', 
     'Value'
);
# # --------------------------------------------------------------------------------------------
# # Name: Working capital
# # Desc: Working capital
# # Date 01/2026
# # Author: Miranda / Helder
# # --------------------------------------------------------------------------------------------
  ['DFS.D.Accounts_ICF':'DFS.D.Accounts_ICF':'WKC.099.002'] = N:
DB( 'DFS.160.Working_Capital',
    !ALL.D.Year,
    !ALL.D.Month,
    !ALL.D.Version,
    !ALL.D.Currency,
    !ALL.D.Region,
