   ['DFS.D.Accounts_ICF':'DFS.D.Accounts_ICF':'FCF.099.010' , 'ALL.D.Currency':'ALL.D.Currency': {'BRL Conv.','EUR Conv.','USD Conv.'}]=N:

   ['DFS.D.Accounts_ICF':'DFS.D.Accounts_ICF':'FCF.099.016' ]    
     
          -
    (
    ['DFS.D.Accounts_ICF':'DFS.D.Accounts_ICF':'FCF.099.007']+
    ['DFS.D.Accounts_ICF':'DFS.D.Accounts_ICF':'FCF.030.002']+
