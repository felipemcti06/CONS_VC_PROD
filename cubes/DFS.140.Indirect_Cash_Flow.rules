 ;
    
# # --------------------------------------------------------------------------------------------
# # Name: Adj EBITDA LTM
# # Desc: Adj EBITDA LTM
# # Date 01/2026
# # Author: Miranda / Helder
# # --------------------------------------------------------------------------------------------
 ['DFS.D.Accounts_ICF':'DFS.D.Accounts_ICF':'FCF.099.019' ]=N:
# # EBITDA
   (
    DB( 'DFS.140.Indirect_Cash_Flow',
    DB('SYS.200.Time_Travel',!ALL.D.Year,!ALL.D.Month,'-12','Ano'), 
    'ALL.D.Month':'YTD 12', 
    !ALL.D.Version,
    !ALL.D.Currency,
    !ALL.D.Region,
    'DRE.099.004',
    !DFS.M.140.Indirect_Cash_Flow )
- 
   DB( 'DFS.140.Indirect_Cash_Flow',
    DB('SYS.200.Time_Travel',!ALL.D.Year,!ALL.D.Month,'-12','Ano'), 
    'YTD ' | !ALL.D.Month, 
    !ALL.D.Version,
    !ALL.D.Currency,
    !ALL.D.Region,
    'DRE.099.004',
    !DFS.M.140.Indirect_Cash_Flow )
+
    DB( 'DFS.140.Indirect_Cash_Flow',
    !ALL.D.Year,
    'YTD ' | !ALL.D.Month, 
    !ALL.D.Version,
    !ALL.D.Currency,
    !ALL.D.Region,
    'DRE.099.004',
    !DFS.M.140.Indirect_Cash_Flow )
   
   )

+
# # Dividends received

   (
    DB( 'DFS.140.Indirect_Cash_Flow',
    DB('SYS.200.Time_Travel',!ALL.D.Year,!ALL.D.Month,'-12','Ano'), 
    'ALL.D.Month':'YTD 12', 
    !ALL.D.Version,
    !ALL.D.Currency,
    !ALL.D.Region,
    'FCF.040.001',
    !DFS.M.140.Indirect_Cash_Flow )
- 
   DB( 'DFS.140.Indirect_Cash_Flow',
    DB('SYS.200.Time_Travel',!ALL.D.Year,!ALL.D.Month,'-12','Ano'), 
    'YTD ' | !ALL.D.Month, 
    !ALL.D.Version,
    !ALL.D.Currency,
    !ALL.D.Region,
    'FCF.040.001',
    !DFS.M.140.Indirect_Cash_Flow )
+
    DB( 'DFS.140.Indirect_Cash_Flow',
    !ALL.D.Year,
    'YTD ' | !ALL.D.Month, 
    !ALL.D.Version,
    !ALL.D.Currency,
    !ALL.D.Region,
    'FCF.040.001',
    !DFS.M.140.Indirect_Cash_Flow )
   
   )
   +
   [ 'DFS.D.Accounts_ICF':'DFS.D.Accounts_ICF':'FCF.099.020'];
   
   C:
    IF( DTYPE( 'ALL.D.Month', !ALL.D.Month )@='C', 

    DB( 'DFS.140.Indirect_Cash_Flow',
        !ALL.D.Year,
        DB('}ElementAttributes_ALL.D.Month', !ALL.D.Month, 'Aux Totalizadores'),
        !ALL.D.Version,
        !ALL.D.Currency,
        !ALL.D.Region,
        !DFS.D.Accounts_ICF,
        !DFS.M.140.Indirect_Cash_Flow )

    , CONTINUE );
   
