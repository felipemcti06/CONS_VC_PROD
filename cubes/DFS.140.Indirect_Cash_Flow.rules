  ['DFS.D.Accounts_ICF':'DFS.D.Accounts_ICF':'DRE.099.004'] = N:
   DB( 'DFS.100.Profit_and_Loss',
       !ALL.D.Year,
       !ALL.D.Month,
       !ALL.D.Version,
       !ALL.D.Currency,
       !ALL.D.Region,
       'ALL.D.Products':'Total Products',
       'DRE.099.004',
       !DFS.M.140.Indirect_Cash_Flow
     );

