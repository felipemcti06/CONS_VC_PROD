# --------------------------------------------------------------------------------------------
# Name Initial Working Capital Balance
# Desc Initial Working Capital Balance
# Date 02/2026
# Author: Miranda / Helder
# --------------------------------------------------------------------------------------------
 ['DFS.D.Accounts_WC':'DFS.D.Accounts_WC':'WKC.030.001','DFS.M.160.Working_Capital':'Value'] = N:

         DB('STG.100.DataBase_Uploads', 
          !ALL.D.Year, 
          !ALL.D.Month, 
          !ALL.D.Version, 
          !ALL.D.Currency, 
          !ALL.D.Region, 
           'ALL.D.Products':'Total Products', 
           'WKC.030.001',
           'ALL.D.Account_Line':'Total Accounts Line', 
           'Value' ) 
  +

   DB( 'DFS.160.Working_Capital',
      DB( 'SYS.200.Time_Travel', !ALL.D.Year, !ALL.D.Month, '-1', 'Ano' )  ,
      DB( 'SYS.200.Time_Travel', !ALL.D.Year, !ALL.D.Month, '-1', 'Mes' ) ,
       !ALL.D.Version,
       !ALL.D.Currency,
       !ALL.D.Region,
       'WKC.099.006',
       'DFS.M.160.Working_Capital':'Total Value'
     )
;

# --------------------------------------------------------------------------------------------
# Name Working Capital'
# DescWorking Capital'
# Date 02/2026
# Author: Miranda / Helder
# --------------------------------------------------------------------------------------------
 ['DFS.D.Accounts_WC':'DFS.D.Accounts_WC':'WKC.099.006'] = N:

DB( 'DFS.160.Working_Capital', 
    !ALL.D.Year,
    !ALL.D.Month,
    !ALL.D.Version,
    !ALL.D.Currency,
    !ALL.D.Region,
    'DFS.D.Accounts_WC':'WKC.099.005',
    !DFS.M.160.Working_Capital 
  )
   -
 DB( 'DFS.160.Working_Capital', 
    !ALL.D.Year,
    !ALL.D.Month,
    !ALL.D.Version,
    !ALL.D.Currency,
    !ALL.D.Region,
    'DFS.D.Accounts_WC':'WKC.099.009',
    !DFS.M.160.Working_Capital 
  )  
   ;


# --------------------------------------------------------------------------------------------
# Name WKC.099.008
# Desc WKC.099.008
# Date 02/2026
# Author: Miranda / Helder
# --------------------------------------------------------------------------------------------
 ['DFS.D.Accounts_WC':'DFS.D.Accounts_WC':'WKC.099.008'] = N:

['DFS.D.Accounts_WC':'DFS.D.Accounts_WC':'WKC.030.001']
   -
 ['DFS.D.Accounts_WC':'DFS.D.Accounts_WC':'WKC.099.006'] 
   
   +
  ['DFS.D.Accounts_WC':'DFS.D.Accounts_WC':'WKC.099.007'] 
  
   ;
# --------------------------------------------------------------------------------------------
# Name Cash Conversion Cycle
# Desc Cash Conversion Cycle
# Date 02/2026
# Author: Miranda / Helder
# --------------------------------------------------------------------------------------------
 ['DFS.D.Accounts_WC':'DFS.D.Accounts_WC':'WKC.030.003'] =

['DFS.D.Accounts_WC':'DFS.D.Accounts_WC':'WKC.030.002']
   +
 ['DFS.D.Accounts_WC':'DFS.D.Accounts_WC':'WKC.010.007'] 
   
   -
  ['DFS.D.Accounts_WC':'DFS.D.Accounts_WC':'WKC.020.001'] 
  
   ;
